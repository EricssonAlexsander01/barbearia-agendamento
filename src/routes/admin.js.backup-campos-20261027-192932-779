
import {
  hashPassword,
  verifyPassword,
  randomToken,
  sha256Hex,
  parseCookies,
  sessionCookie
} from '../services/security.js';

import { nowIso } from '../services/time.js';
import { HttpError } from '../services/appointments.js';
import { auditStatement } from '../services/audit.js';

export async function handleAdmin(request, env, url, requestId) {
  // =========================================================
  // LOGIN ADMINISTRATIVO
  // POST /api/admin/login
  // =========================================================
  if (
    request.method === 'POST' &&
    url.pathname === '/api/admin/login'
  ) {
    const body = await request.json().catch(() => ({}));

    const login = String(body.login || '').trim().toLowerCase();
    const password = String(body.password || '');

    const admin = await env.DB.prepare(`
      SELECT id, password_hash
      FROM admins
      WHERE login = ? AND ativo = 1
    `).bind(login).first();

    if (
      !admin ||
      !(await verifyPassword(admin.password_hash, password))
    ) {
      await env.DB.prepare(`
        INSERT INTO audit_logs (
          id,
          occurred_at,
          actor_type,
          action,
          entity_type,
          entity_id,
          request_id
        )
        VALUES (?, ?, 'SYSTEM', 'ADMIN_LOGIN_FAILED', 'ADMIN', NULL, ?)
      `).bind(
        crypto.randomUUID(),
        nowIso(),
        requestId
      ).run();

      throw new HttpError(401, 'Login ou senha inválidos.');
    }

    const token = randomToken(32);
    const tokenHash = await sha256Hex(token);
    const now = nowIso();

    const ttlHours = Number(env.SESSION_TTL_HOURS || 12);
    const expires = new Date(
      Date.now() + ttlHours * 3600_000
    ).toISOString();

    const sessionId = crypto.randomUUID();

    await env.DB.batch([
      env.DB.prepare(`
        INSERT INTO admin_sessions (
          id,
          admin_id,
          token_hash,
          criado_em,
          expira_em
        )
        VALUES (?, ?, ?, ?, ?)
      `).bind(
        sessionId,
        admin.id,
        tokenHash,
        now,
        expires
      ),

      auditStatement(env.DB, {
        actorType: 'ADMIN',
        actorId: admin.id,
        action: 'ADMIN_LOGIN_SUCCEEDED',
        entityType: 'ADMIN_SESSION',
        entityId: sessionId,
        requestId
      })
    ]);

    return new Response(
      JSON.stringify({ ok: true }),
      {
        headers: {
          'Content-Type': 'application/json; charset=utf-8',
          'Cache-Control': 'no-store',
          'Set-Cookie': sessionCookie(token, ttlHours * 3600)
        }
      }
    );
  }

  // =========================================================
  // LOGOUT ADMINISTRATIVO
  // POST /api/admin/logout
  // =========================================================
  if (
    request.method === 'POST' &&
    url.pathname === '/api/admin/logout'
  ) {
    const admin = await requireAdmin(request, env);

    const token = parseCookies(request).admin_session;
    const tokenHash = await sha256Hex(token);
    const now = nowIso();

    await env.DB.batch([
      env.DB.prepare(`
        UPDATE admin_sessions
        SET revogado_em = ?
        WHERE token_hash = ?
          AND revogado_em IS NULL
      `).bind(now, tokenHash),

      env.DB.prepare(`
        INSERT INTO audit_logs (
          id,
          occurred_at,
          actor_type,
          actor_id,
          action,
          entity_type,
          request_id
        )
        VALUES (
          ?, ?, 'ADMIN', ?, 'ADMIN_LOGOUT',
          'ADMIN_SESSION', ?
        )
      `).bind(
        crypto.randomUUID(),
        now,
        admin.id,
        requestId
      )
    ]);

    return new Response(
      JSON.stringify({ ok: true }),
      {
        headers: {
          'Content-Type': 'application/json; charset=utf-8',
          'Cache-Control': 'no-store',
          'Set-Cookie':
            'admin_session=; Path=/; HttpOnly; Secure; SameSite=Strict; Max-Age=0'
        }
      }
    );
  }

  // Rotas abaixo exigem sessão administrativa válida.
  if (url.pathname.startsWith('/api/admin/')) {
    const admin = await requireAdmin(request, env);

    // =======================================================
    // LISTAGEM DE AGENDAMENTOS
    // GET /api/admin/appointments?from=...&to=...
    // =======================================================
    if (
      request.method === 'GET' &&
      url.pathname === '/api/admin/appointments'
    ) {
      const from = url.searchParams.get('from');
      const to = url.searchParams.get('to');

      if (!from || !to) {
        throw new HttpError(
          400,
          'Informe from e to em UTC ISO 8601.'
        );
      }

      const result = await env.DB.prepare(`
        SELECT
          a.id,
          a.barber_id,
          b.nome AS barbeiro,
          a.service_id,
          COALESCE(
            (
              SELECT group_concat(servicos.nome_snapshot, ' + ')
              FROM (
                SELECT aps.nome_snapshot
                FROM appointment_services aps
                WHERE aps.appointment_id = a.id
                ORDER BY aps.ordem
              ) AS servicos
            ),
            s.nome
          ) AS servico,
          CASE
            WHEN EXISTS (
              SELECT 1
              FROM appointment_services aps
              WHERE aps.appointment_id = a.id
            )
            THEN (
              SELECT COUNT(*)
              FROM appointment_services aps
              WHERE aps.appointment_id = a.id
            )
            ELSE 1
          END AS quantidade_servicos,
          a.preco_snapshot_centavos AS preco_centavos,
          a.duracao_min_snapshot AS duracao_minutos,
          a.cliente_nome,
          substr(a.cliente_telefone, -4) AS telefone_final,
          a.inicio,
          a.fim,
          a.status
        FROM appointments a
        JOIN barbers b ON b.id = a.barber_id
        JOIN services s ON s.id = a.service_id
        WHERE a.inicio >= ?
          AND a.inicio < ?
        ORDER BY a.inicio
      `).bind(from, to).all();

      return json({
        appointments: result.results || []
      });
    }

    // =======================================================
    // CANCELAMENTO ADMINISTRATIVO
    // POST /api/admin/appointments/cancel
    // =======================================================
    if (
      request.method === 'POST' &&
      url.pathname === '/api/admin/appointments/cancel'
    ) {
      const body = await request.json().catch(() => ({}));

      const appointmentId = String(
        body.appointment_id || ''
      ).trim();

      const reason = String(
        body.reason || 'Cancelado pelo administrador'
      ).trim().slice(0, 250);

      if (!appointmentId) {
        throw new HttpError(
          400,
          'Informe appointment_id.'
        );
      }

      const now = nowIso();

      const update = env.DB.prepare(`
        UPDATE appointments
        SET status = 'CANCELADO'
        WHERE id = ?
          AND status = 'AGENDADO'
      `).bind(appointmentId);

      const audit = env.DB.prepare(`
        INSERT INTO audit_logs (
          id, occurred_at, actor_type, actor_id, action,
          entity_type, entity_id, after_json, reason, request_id
        )
        SELECT ?, ?, 'ADMIN', ?, 'APPOINTMENT_CANCELLED_BY_ADMIN',
               'APPOINTMENT', ?, NULL, ?, ?
        WHERE changes() = 1
      `).bind(
        crypto.randomUUID(),
        now,
        admin.id,
        appointmentId,
        reason || 'Cancelado pelo administrador',
        requestId
      );

      const result = await env.DB.batch([update, audit]);

      if (Number(result[0]?.meta?.changes) !== 1) {
        throw new HttpError(
          409,
          'Agendamento não encontrado ou não está mais ativo.'
        );
      }

      return json({ ok: true });
    }

    // =======================================================
    // REGISTRO DE NO-SHOW
    // POST /api/admin/appointments/no-show
    // =======================================================
    if (
      request.method === 'POST' &&
      url.pathname === '/api/admin/appointments/no-show'
    ) {
      const body = await request.json().catch(() => ({}));

      const appointmentId = String(
        body.appointment_id || ''
      ).trim();

      const reason = String(
        body.reason || 'Cliente não compareceu'
      ).trim().slice(0, 250);

      if (!appointmentId) {
        throw new HttpError(
          400,
          'Informe appointment_id.'
        );
      }

      const now = nowIso();

      const update = env.DB.prepare(`
        UPDATE appointments
        SET status = 'NO_SHOW'
        WHERE id = ?
          AND status = 'AGENDADO'
          AND inicio < ?
      `).bind(appointmentId, now);

      const audit = env.DB.prepare(`
        INSERT INTO audit_logs (
          id, occurred_at, actor_type, actor_id, action,
          entity_type, entity_id, after_json, reason, request_id
        )
        SELECT ?, ?, 'ADMIN', ?, 'APPOINTMENT_MARKED_NO_SHOW',
               'APPOINTMENT', ?, NULL, ?, ?
        WHERE changes() = 1
      `).bind(
        crypto.randomUUID(),
        now,
        admin.id,
        appointmentId,
        reason || 'Cliente não compareceu',
        requestId
      );

      const result = await env.DB.batch([update, audit]);

      if (Number(result[0]?.meta?.changes) !== 1) {
        throw new HttpError(
          409,
          'O agendamento não existe, não está ativo ou ainda não começou.'
        );
      }

      return json({ ok: true });
    }

    throw new HttpError(
      404,
      'Endpoint administrativo não encontrado.'
    );
  }

  return null;
}

// ===========================================================
// VALIDAÇÃO DA SESSÃO ADMINISTRATIVA
// ===========================================================
export async function requireAdmin(request, env) {
  const token = parseCookies(request).admin_session;

  if (!token) {
    throw new HttpError(
      401,
      'Autenticação necessária.'
    );
  }

  const tokenHash = await sha256Hex(token);

  const row = await env.DB.prepare(`
    SELECT
      a.id,
      a.login
    FROM admin_sessions s
    JOIN admins a ON a.id = s.admin_id
    WHERE s.token_hash = ?
      AND s.revogado_em IS NULL
      AND s.expira_em > ?
      AND a.ativo = 1
    LIMIT 1
  `).bind(
    tokenHash,
    nowIso()
  ).first();

  if (!row) {
    throw new HttpError(
      401,
      'Sessão inválida ou expirada.'
    );
  }

  return row;
}

// ===========================================================
// RESPOSTAS JSON
// ===========================================================
function json(data, status = 200) {
  return new Response(
    JSON.stringify(data),
    {
      status,
      headers: {
        'Content-Type': 'application/json; charset=utf-8',
        'Cache-Control': 'no-store'
      }
    }
  );
}
